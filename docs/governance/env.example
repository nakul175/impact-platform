# Impact Platform: configuration reference (docs/governance/env.example; a copy named .env.example at the repo root is a follow-up, see docs/governance/README.md). NAMES ONLY; no values. Copy to .env (git-ignored) only for a
# local, synthetic-data run; the application itself reads real environment variables or a JSON file, not
# this file. Last reviewed 2026-10-08. Owner: Nakul Jain.
# Update trigger: any new field in apps/api/impact_api/config.py (Settings), worker.py (WorkerSettings),
# application_executor.py, deploy/compose.yaml or specification/contracts/deployment-inputs.json.
# Sources: those files. Staging values live only in /opt/impact/secrets.env and config.env on the server
# (docs/current/DEPLOYMENT-GUIDE.md section 8); never commit them.
# Convention: IMPACT_<FIELD> overrides a field of the JSON file named by IMPACT_CONFIG_FILE (API) or
# IMPACT_WORKER_CONFIG_FILE (worker). Booleans: 1/true/yes/on or 0/false/no/off.

# --- API: core (Settings) -------------------------------------------------------------------------
IMPACT_CONFIG_FILE=
IMPACT_ENVIRONMENT=            # development | test | staging | production
IMPACT_PUBLIC_ORIGIN=
IMPACT_FIXTURE_ID=
IMPACT_REQUIRE_UNPRIVILEGED_DB=   # always on in staging/production

# --- API: database logins (secret; DSNs carry passwords) ---------------------------------------------
IMPACT_APP_DSN=
IMPACT_IDENTITY_DSN=
IMPACT_PLATFORM_DSN=
IMPACT_WORKER_DSN=             # worker process only
IMPACT_EXECUTOR_DSN=           # application executor only
IMPACT_EXECUTOR_ID=
IMPACT_MIGRATION_DSN=          # migration job only; never given to the API
IMPACT_FIXTURE_DSN=            # disposable test database only
IMPACT_TEST_DSN=
IMPACT_ADMIN_DSN=              # deploy/prepare_database.py only
IMPACT_LOGIN_PASSWORD_APP=
IMPACT_LOGIN_PASSWORD_IDENTITY=
IMPACT_LOGIN_PASSWORD_PLATFORM=
IMPACT_LOGIN_PASSWORD_WORKER=
IMPACT_LOGIN_PASSWORD_EXECUTOR=
IMPACT_LOGIN_PASSWORD_MIGRATOR=
IMPACT_DEV_DB_SERIAL=
IMPACT_DEV_DB_PORT=

# --- API: identity provider ---------------------------------------------------------------------------
IMPACT_ISSUER=
IMPACT_CLIENT_ID=
IMPACT_AUDIENCE=
IMPACT_JWKS_URL=
IMPACT_AUTHORIZATION_URL=
IMPACT_TOKEN_URL=
IMPACT_END_SESSION_URL=
IMPACT_REQUIRED_ACR=
IMPACT_CLIENT_SECRET=          # empty for the public PKCE client
IMPACT_PROVIDER_ACCOUNT_URL=
IMPACT_PROVIDER_ADMIN=         # keycloak | development | empty
IMPACT_PROVIDER_ADMIN_URL=
IMPACT_PROVIDER_ADMIN_REALM=
IMPACT_PROVIDER_ADMIN_CLIENT_ID=
IMPACT_PROVIDER_ADMIN_CLIENT_SECRET=
IMPACT_PROVISIONER_SECRET=
IMPACT_REALM=

# --- Application secrets (keyrings; docs/current/KEY-AND-ENCRYPTION-REGISTER.md) ---------------------------
IMPACT_COOKIE_SECRET=
IMPACT_INVITATION_SECRET=
IMPACT_DELIVERY_SECRET=
IMPACT_COOKIE_SECRET_PREVIOUS=
IMPACT_INVITATION_SECRET_PREVIOUS=
IMPACT_DELIVERY_SECRET_PREVIOUS=

# --- Development sign-in only (never on a server) --------------------------------------------------------
IMPACT_DEV_AUTH=
IMPACT_DEV_USERS_FILE=
IMPACT_DEV_PUBLIC_KEY=
IMPACT_DEV_SIGNING_KEYS=

# --- Evidence store and operations files -----------------------------------------------------------------
IMPACT_OBJECT_STORE_BACKEND=
IMPACT_OBJECT_STORE_DIR=
IMPACT_EVIDENCE_SCANNER=
IMPACT_OPS_STATUS_FILE=
IMPACT_ON_CALL_FILE=

# --- AI advisory (off by default; docs/governance/AI-MODEL-CARD.md) ------------------------------------------
IMPACT_AI_ENABLED=
IMPACT_AI_API_KEY=
OPENAI_API_KEY=
IMPACT_AI_MODEL=

# --- Worker (WorkerSettings) --------------------------------------------------------------------------------
IMPACT_WORKER_CONFIG_FILE=
IMPACT_EMAIL_ADAPTER=          # smtp | synthetic
IMPACT_SMTP_HOST=
IMPACT_SMTP_PORT=
IMPACT_SMTP_USERNAME=
IMPACT_SMTP_PASSWORD=
IMPACT_SMTP_FROM=
IMPACT_SMTP_TIMEOUT=
IMPACT_SMTP_STARTTLS=
IMPACT_SMTP_CA_FILE=
IMPACT_EMAIL_RATE_LIMIT=
IMPACT_EMAIL_TENANT_RATE_LIMIT=
IMPACT_EMAIL_RATE_WINDOW_SECONDS=
IMPACT_SYNTHETIC_SINK=
IMPACT_SYNTHETIC_FAILURES=
IMPACT_SYNTHETIC_DELAY=
IMPACT_LEASE_SECONDS=
IMPACT_POLL_SECONDS=
IMPACT_BATCH_SIZE=
IMPACT_MAX_ATTEMPTS=
IMPACT_SCAN_SECONDS=
IMPACT_RETENTION_SECONDS=

# --- Server deployment (deploy/compose.yaml, config.env, secrets.env) -------------------------------------
IMPACT_HOME=
IMPACT_TAG=
IMPACT_APP_HOST=
IMPACT_AUTH_HOST=
IMPACT_OWNER_EMAIL=
